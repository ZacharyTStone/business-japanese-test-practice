# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for live generation.
# The offline commands (selftest, practice --demo) need none of these.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- optional overrides (defaults shown) ---
# BJT_MODEL=claude-opus-5           # generator model
# BJT_JUDGE_MODEL=claude-opus-5     # gate + discriminator judge (drop to a smaller model to cut cost)
# BJT_DB_PATH=bjt.db
# BJT_SEEDS_DIR=seeds
# BJT_GATE_TRIALS=3

# --- scene artwork (bjt scenes --generate) ---
# OPENAI_API_KEY=sk-...                 # the image model; ANTHROPIC_API_KEY reviews each draft
# BJT_IMAGE_MODEL=gpt-image-1
# BJT_IMAGE_QUALITY=high
# BJT_SCENE_ATTEMPTS=3                  # drafts the review may reject per scene

# --- audio (bjt synth, bjt audition) ---
# One key gives the bank a voice. `bjt audition` writes the same lines from
# every provider that has a key, side by side, for a person to listen to; then
# pin the winner, because the cast is fixed for the life of the library.
# GEMINI_API_KEY=...                    # Google AI Studio key (the lightest to set up)
# OPENAI_API_KEY=sk-...                 # the same key as the scene artwork
# BJT_TTS_PROVIDER=gemini               # gemini | openai | google — the audition's verdict
# BJT_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# BJT_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- uploading artwork and audio (bjt scenes --upload, bjt synth --upload) ---
# The service-role key bypasses row-level security. It belongs here or in a
# GitHub secret, never in client/ and never in a commit.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
