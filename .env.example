# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for live generation.
# The offline commands (selftest, practice --demo) need none of these.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- optional overrides (defaults shown) ---
# BJT_MODEL=claude-opus-5           # generator model
# BJT_JUDGE_MODEL=claude-opus-5     # gate + discriminator judge (drop to a smaller model to cut cost)
# BJT_DB_PATH=bjt.db
# BJT_SEEDS_DIR=seeds
# BJT_GATE_TRIALS=3

# --- scene artwork (bjt scenes --generate) ---
# OPENAI_API_KEY=sk-...                 # the image model; ANTHROPIC_API_KEY reviews each draft
# BJT_IMAGE_MODEL=gpt-image-1
# BJT_IMAGE_QUALITY=high
# BJT_SCENE_ATTEMPTS=3                  # drafts the review may reject per scene

# --- uploading artwork (bjt scenes --upload) ---
# The service-role key bypasses row-level security. It belongs here or in a
# GitHub secret, never in client/ and never in a commit.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
