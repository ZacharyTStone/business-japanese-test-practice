# Licensed / authoritative material stays out of the repo.
seeds/

# Local SQLite database.
*.db
bjt.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# local env (contains your API key)
.env
.env.local

# Wrangler's local state: a local D1 and R2 for `wrangler dev`.
.wrangler/

# Generated media, before it is uploaded. Large, regenerable, and its home is
# object storage — `bjt synth` and `bjt scenes` write here.
media/

# What `bjt nightly` leaves behind on a local run. The bundles it writes are the
# deliverable and are committed; the run's own notes are not.
/plan.json
/summary.md

# macOS
.DS_Store

node_modules/
