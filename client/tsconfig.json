{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // An import, a variable or a parameter nothing reads is a leftover or a
    // bug; an override is said so. JSX needs no React in scope (react-jsx).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true
  },
  // The Worker runs on workerd, not React Native, and is checked against its
  // own types (worker/tsconfig.json); `npm run typecheck` runs both.
  "exclude": ["worker", "node_modules", "dist"]
}
