# Copy to client/.env and fill in from your Supabase project settings.
#
# Both of these are PUBLIC and ship inside the app — that is what the EXPO_PUBLIC_
# prefix means. The anon key identifies the project, it does not authorise
# anything: every table is behind row-level security, so what this key can reach
# is exactly what an anonymous visitor is allowed to reach.
#
# The service_role key must NEVER appear in this file or anywhere in client/.
# It bypasses row-level security entirely and is only used from a laptop to
# apply `bjt publish` output.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
