{
  // The Worker name in the Cloudflare dashboard must match this exactly, or
  // the build fails. Note it is not "bjt-…": BJT is a registered trademark and
  // does not go in a product name, slug, or identifier.
  "name": "business-japanese-test-practice",
  "compatibility_date": "2026-09-14",

  // The API and the media (worker/index.ts). Everything else is the static
  // web build below, served without running this script.
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only these reach the script first; every other path is an asset.
    // /auth/* is a native build's sign-in (worker/native.ts).
    "run_worker_first": ["/api/*", "/media/*", "/auth/*"],

    // expo-router exports one HTML file per route, so a miss is a genuine miss
    // and should say so. `npm run build:web` leaves a 404.html for this to
    // find — Expo writes the page as +not-found.html, which Workers would not
    // recognise on its own.
    "not_found_handling": "404-page",

    // Serves /practice from practice.html without inventing a trailing slash.
    "html_handling": "auto-trailing-slash"
  },

  // The database: D1, the schema in ../d1/migrations, applied by the deploy
  // workflow (`wrangler d1 migrations apply --remote`). The id is not a
  // secret; it names the database inside this account and nothing more.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "business-japanese-drill",
      "database_id": "55f4024e-aa7a-4bfe-a8ca-e86648a5a317",
      "migrations_dir": "../d1/migrations"
    }
  ],

  // The clips and the pictures (worker/media.ts), keyed `audio/<path>` and
  // `scenes/<path>`. Private: served only through this Worker.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "business-japanese-drill-media"
    }
  ],

  // Who is asking: the token Cloudflare Access signs on every request it lets
  // through, checked by worker/access.ts against these two — the team whose
  // keys must have signed it, and the Access application it must be for (its
  // AUD tag). Neither is a secret: both are written in every token the browser
  // holds. Left empty, every query is refused. No secrets: what a person may
  // see is the tester list in D1.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "crimson-voice-2494.cloudflareaccess.com",
    "ACCESS_AUD": "389ce98e459bc80833ee3c9cde1bf75389241d720edb8a4a1421b0e73afbf63b"
  }
}
