      "channel": "in_person"
    },
    {
      "clip_id": "931ae91ce00eb05d",
      "item_id": "dd4aa457b1",
      "kind": "dialogue",
      "index": 1,
      "text": "こちらの控えは千円です。どちらが新しいのでしょうか。",
