          "clip_id": "8b748dd1583178f1"
        },
        {
          "speaker_role": "同僚B",
          "text": "ただ、私のほうは来月から御社に常駐しますので、その場で受けられます。",
          "clip_id": "183e6464ad06c798"
        },
        {
          "speaker_role": "取引先の担当者",
          "text": "常駐していただけるなら、そのほうが助かりますね。",
